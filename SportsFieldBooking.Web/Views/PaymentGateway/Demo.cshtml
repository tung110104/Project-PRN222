@{
    Layout = null; // Cong thanh toan la trang doc lap, khong dung layout cua site (giong redirect sang domain khac)
    var type = (string)ViewBag.Type;
    var id = (int)ViewBag.Id;
    var method = (string)ViewBag.Method;
    var pointsToUse = (int)ViewBag.PointsToUse;
    var amount = (decimal)ViewBag.Amount;
    var orderInfo = (string)ViewBag.OrderInfo;
    var isMomo = method == "Momo";
    var brand = isMomo ? "MoMo" : "VNPAY";
    var brandColor = isMomo ? "#a50064" : "#005baa";
    var txnCode = $"{method.ToUpper()}{DateTime.Now:yyyyMMddHHmmss}";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cổng thanh toán @brand (Sandbox)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: #f0f2f5; }
        .gateway-header { background: @brandColor; color: #fff; }
        .qr-box { width: 180px; height: 180px; margin: 0 auto; background:
            repeating-conic-gradient(#212529 0% 25%, #fff 0% 50%) 0 0 / 20px 20px;
            border: 8px solid #fff; outline: 2px solid #dee2e6; position: relative; }
        .qr-box::after { content: "@brand"; position: absolute; inset: 0; display: flex; align-items: center;
            justify-content: center; font-weight: 700; font-size: 12px; color: #fff;
            background: @brandColor; width: 46px; height: 46px; margin: auto; border-radius: 8px; }
        .brand-badge { letter-spacing: 1px; }
    </style>
</head>
<body>
    <div class="gateway-header py-3 mb-4 shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold brand-badge"><i class="bi bi-shield-lock"></i> @brand <small class="fw-normal">Cổng thanh toán</small></h4>
            <span class="badge bg-warning text-dark">SANDBOX - MÔI TRƯỜNG THỬ NGHIỆM</span>
        </div>
    </div>

    <div class="container" style="max-width: 900px;">
        <div class="row g-4">
            <div class="col-md-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-white"><strong>Thông tin đơn hàng</strong></div>
                    <div class="card-body">
                        <p class="text-muted small mb-1">Nhà cung cấp</p>
                        <p class="fw-bold mb-3">SportBooking - Sports Field Booking System</p>
                        <p class="text-muted small mb-1">Nội dung</p>
                        <p class="mb-3">@orderInfo</p>
                        @if (pointsToUse > 0)
                        {
                            <p class="text-muted small mb-1">Điểm tích lũy sử dụng</p>
                            <p class="mb-3">@pointsToUse điểm</p>
                        }
                        <p class="text-muted small mb-1">Mã giao dịch</p>
                        <p class="mb-3"><code>@txnCode</code></p>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Số tiền thanh toán</span>
                            <h4 class="mb-0" style="color:@brandColor">@amount.ToString("N0") VND</h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <strong>Quét mã QR để thanh toán</strong>
                        <span class="text-muted small">Hết hạn sau <span id="countdown" class="fw-bold text-danger">15:00</span></span>
                    </div>
                    <div class="card-body text-center">
                        <div class="qr-box mb-3"></div>
                        <p class="text-muted small">
                            Mở ứng dụng @(isMomo ? "MoMo" : "ngân hàng / VNPAY") và quét mã QR<br />
                            hoặc bấm nút bên dưới để mô phỏng kết quả giao dịch (demo môn học).
                        </p>

                        <form method="post" asp-controller="PaymentGateway" asp-action="DemoComplete" class="d-grid gap-2 col-10 mx-auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="type" value="@type" />
                            <input type="hidden" name="id" value="@id" />
                            <input type="hidden" name="method" value="@method" />
                            <input type="hidden" name="pointsToUse" value="@pointsToUse" />
                            <input type="hidden" name="amount" value="@amount" />
                            <button name="success" value="true" class="btn btn-lg text-white" style="background:@brandColor">
                                <i class="bi bi-check-circle"></i> Xác nhận đã thanh toán @amount.ToString("N0")đ
                            </button>
                            <button name="success" value="false" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Hủy giao dịch
                            </button>
                        </form>
                    </div>
                    <div class="card-footer bg-white text-center text-muted small">
                        <i class="bi bi-lock-fill"></i> Giao dịch được mã hóa an toàn ·
                        Cấu hình <code>VnPay:TmnCode</code> trong appsettings.json để chuyển sang cổng VNPay sandbox thật
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Dem nguoc 15 phut giong cong that
        let secs = 15 * 60;
        setInterval(() => {
            if (secs <= 0) return;
            secs--;
            const m = String(Math.floor(secs / 60)).padStart(2, '0');
            const s = String(secs % 60).padStart(2, '0');
            document.getElementById('countdown').textContent = `${m}:${s}`;
        }, 1000);
    </script>
</body>
</html>
