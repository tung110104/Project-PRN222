@model List<User>
@{
    ViewData["Title"] = "Cứu hộ Admin";
}
<div class="alert alert-warning">
    <i class="bi bi-shield-lock"></i> <strong>Super Account</strong> — tài khoản cứu hộ cấu hình trong appsettings,
    không tồn tại trong database. Dùng để cấp / thu hồi quyền Admin khi tài khoản Admin bị mất hoặc bị khóa.
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.UserId</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Role.RoleName == "Admin")
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@u.Role.RoleName</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đã khóa</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (u.Role.RoleName == "Admin")
                            {
                                <form method="post" asp-action="RevokeAdmin" asp-route-id="@u.UserId" class="d-inline"
                                      onsubmit="return confirm('Thu hồi quyền Admin của @u.Email?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">Thu hồi Admin</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="GrantAdmin" asp-route-id="@u.UserId" class="d-inline"
                                      onsubmit="return confirm('Cấp quyền Admin cho @u.Email?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-success">Cấp Admin</button>
                                </form>
                            }
                            <form method="post" asp-action="ToggleActive" asp-route-id="@u.UserId" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-secondary">@(u.IsActive ? "Khóa" : "Mở khóa")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
