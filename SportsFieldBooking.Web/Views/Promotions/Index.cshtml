@model List<Promotion>
@{
    ViewData["Title"] = "Khuyến mãi";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-ticket-perforated"></i> Quản lý khuyến mãi</h3>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Thêm khuyến mãi</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Mô tả</th>
                    <th>Giảm</th>
                    <th>Giảm tối đa</th>
                    <th>Hiệu lực</th>
                    <th>Còn lại</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><code>@p.Code</code></td>
                        <td>@p.Description</td>
                        <td>@p.DiscountPercent%</td>
                        <td>@(p.MaxDiscount > 0 ? p.MaxDiscount.ToString("N0") + "đ" : "Không giới hạn")</td>
                        <td>@p.StartDate.ToString("dd/MM/yyyy") - @p.EndDate.ToString("dd/MM/yyyy")</td>
                        <td>@p.Quantity</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Đang chạy</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm dừng</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@p.PromotionId" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form method="post" asp-action="ToggleActive" asp-route-id="@p.PromotionId" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-secondary">@(p.IsActive ? "Dừng" : "Kích hoạt")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
