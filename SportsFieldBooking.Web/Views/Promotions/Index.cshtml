@model List<Promotion>
@{
    ViewData["Title"] = "Khuyến mãi";
    var isAdmin = User.IsInRole("Admin");
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-ticket-perforated"></i> Quản lý khuyến mãi</h3>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Thêm khuyến mãi</a>
</div>

<div class="alert alert-info py-2">
    <i class="bi bi-envelope"></i> Mã khuyến mãi được <strong>gửi qua email</strong> cho khách hàng (không phát offline):
    mã của chủ sân gửi tới khách đã từng đặt sân của bạn@(isAdmin ? "; mã hệ thống (Admin) gửi tới tất cả khách hàng" : "").
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Mô tả</th>
                    @if (isAdmin)
                    {
                        <th>Phạm vi</th>
                    }
                    <th>Giảm</th>
                    <th>Hiệu lực</th>
                    <th>Còn lại</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><code>@p.Code</code></td>
                        <td>@p.Description</td>
                        @if (isAdmin)
                        {
                            <td>
                                @if (p.OwnerId == null)
                                {
                                    <span class="badge bg-danger">Hệ thống</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@p.Owner?.FullName</span>
                                }
                            </td>
                        }
                        <td>@p.DiscountPercent% @(p.MaxDiscount > 0 ? $"(tối đa {p.MaxDiscount:N0}đ)" : "")</td>
                        <td>@p.StartDate.ToString("dd/MM/yy") - @p.EndDate.ToString("dd/MM/yy")</td>
                        <td>@p.Quantity</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Đang chạy</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm dừng</span>
                            }
                        </td>
                        <td class="text-end" style="min-width:220px">
                            <a asp-action="SendEmail" asp-route-id="@p.PromotionId" class="btn btn-sm btn-primary">
                                <i class="bi bi-envelope"></i> Gửi email
                            </a>
                            <a asp-action="Edit" asp-route-id="@p.PromotionId" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form method="post" asp-action="ToggleActive" asp-route-id="@p.PromotionId" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-secondary">@(p.IsActive ? "Dừng" : "Kích hoạt")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="card-body text-center text-muted">Chưa có khuyến mãi nào.</div>
    }
</div>
