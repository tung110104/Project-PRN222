@model Field
@{
    ViewData["Title"] = "Giá & Khung giờ - " + Model.FieldName;
    var rules = (List<FieldPricingRule>)ViewBag.Rules;
    var goldenDays = (List<GoldenDay>)ViewBag.GoldenDays;
    var allSlots = (List<TimeSlot>)ViewBag.AllSlots;
    string DayTypeLabel(string d) => d switch
    {
        "Weekday" => "Thứ 2 - Thứ 6",
        "Weekend" => "Thứ 7 - CN",
        _ => "Mọi ngày"
    };
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-cash-stack"></i> Giá &amp; Khung giờ: @Model.FieldName</h3>
    <a asp-controller="FieldsManage" asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</div>

<div class="alert alert-info py-2">
    Giá cơ bản của sân: <strong>@Model.PricePerHour.ToString("N0")đ/giờ</strong>.
    Khi khách đặt, hệ thống lấy quy tắc giá <strong>khớp và có ưu tiên cao nhất</strong> (khung giờ + loại ngày + khoảng tháng/mùa);
    không quy tắc nào khớp thì dùng giá cơ bản. Ngày vàng nhân thêm hệ số giá.
</div>

<div class="row g-4">
    @* ---------- Bang gia da cap ---------- *@
    <div class="col-lg-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white"><strong><i class="bi bi-sliders"></i> Bảng giá chi tiết (theo giờ / ngày / tháng-mùa)</strong></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tên</th><th>Khung giờ</th><th>Loại ngày</th><th>Tháng</th>
                            <th class="text-end">Giá</th><th>Ưu tiên</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rules)
                        {
                            <tr>
                                <td>@(r.RuleName ?? "-")</td>
                                <td>@r.StartTime.ToString("HH:mm") - @r.EndTime.ToString("HH:mm")</td>
                                <td>@DayTypeLabel(r.DayType)</td>
                                <td>@(r.StartMonth.HasValue ? $"T{r.StartMonth} - T{r.EndMonth}" : "Quanh năm")</td>
                                <td class="text-end text-success fw-bold">@r.Price.ToString("N0")đ</td>
                                <td>@r.Priority</td>
                                <td class="text-end">
                                    <form method="post" asp-action="DeleteRule" class="d-inline"
                                          onsubmit="return confirm('Xóa quy tắc giá này?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="fieldId" value="@Model.FieldId" />
                                        <input type="hidden" name="ruleId" value="@r.PricingRuleId" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!rules.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted">Chưa có quy tắc giá - đang dùng giá cơ bản cho mọi khung giờ.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-body border-top">
                <form method="post" asp-action="AddRule" class="row g-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fieldId" value="@Model.FieldId" />
                    <div class="col-md-4">
                        <input name="ruleName" class="form-control form-control-sm" placeholder="Tên (VD: Giờ vàng tối)" />
                    </div>
                    <div class="col-md-2">
                        <input name="startTime" type="time" class="form-control form-control-sm" value="17:00" required />
                    </div>
                    <div class="col-md-2">
                        <input name="endTime" type="time" class="form-control form-control-sm" value="21:00" required />
                    </div>
                    <div class="col-md-4">
                        <select name="dayType" class="form-select form-select-sm">
                            <option value="All">Mọi ngày</option>
                            <option value="Weekday">Thứ 2 - Thứ 6</option>
                            <option value="Weekend">Thứ 7 - CN</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input name="startMonth" type="number" min="1" max="12" class="form-control form-control-sm" placeholder="Từ tháng" />
                    </div>
                    <div class="col-md-2">
                        <input name="endMonth" type="number" min="1" max="12" class="form-control form-control-sm" placeholder="Đến tháng" />
                    </div>
                    <div class="col-md-3">
                        <input name="price" type="number" min="1000" class="form-control form-control-sm" placeholder="Giá (đ/giờ)" required />
                    </div>
                    <div class="col-md-2">
                        <input name="priority" type="number" value="1" class="form-control form-control-sm" title="Ưu tiên - số lớn thắng" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-sm btn-success w-100"><i class="bi bi-plus-lg"></i> Thêm quy tắc</button>
                    </div>
                    <small class="text-muted">Bỏ trống "Từ tháng / Đến tháng" = áp dụng quanh năm. Mùa vắt qua năm nhập VD: từ tháng 11 đến tháng 2.</small>
                </form>
            </div>
        </div>

        @* ---------- Ngay vang ---------- *@
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong><i class="bi bi-star-fill text-warning"></i> Ngày vàng</strong></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Ngày</th><th>Tên</th><th>Hệ số giá</th><th>Hệ số điểm</th><th>Phạm vi</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var g in goldenDays)
                        {
                            <tr>
                                <td>@g.Date.ToString("dd/MM/yyyy")</td>
                                <td>@g.Name</td>
                                <td>x@(g.PriceMultiplier.ToString("0.##"))</td>
                                <td>x@(g.PointsMultiplier)</td>
                                <td>
                                    @if (g.FieldId == null)
                                    {
                                        <span class="badge bg-danger">Hệ thống</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Sân này</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (g.FieldId != null || User.IsInRole("Admin"))
                                    {
                                        <form method="post" asp-action="DeleteGoldenDay" class="d-inline"
                                              onsubmit="return confirm('Xóa ngày vàng này?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="fieldId" value="@Model.FieldId" />
                                            <input type="hidden" name="goldenDayId" value="@g.GoldenDayId" />
                                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!goldenDays.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted">Chưa có ngày vàng nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-body border-top">
                <form method="post" asp-action="AddGoldenDay" class="row g-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fieldId" value="@Model.FieldId" />
                    <div class="col-md-3">
                        <input name="date" type="date" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-md-3">
                        <input name="name" class="form-control form-control-sm" placeholder="Tên (VD: Tết Dương lịch)" required />
                    </div>
                    <div class="col-md-2">
                        <input name="priceMultiplier" type="number" step="0.1" min="1" max="5" value="1.5" class="form-control form-control-sm" title="Hệ số giá" />
                    </div>
                    <div class="col-md-2">
                        <input name="pointsMultiplier" type="number" min="1" max="10" value="2" class="form-control form-control-sm" title="Hệ số điểm" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-sm btn-warning w-100"><i class="bi bi-plus-lg"></i> Thêm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ---------- Khung gio ---------- *@
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong><i class="bi bi-clock"></i> Khung giờ của sân</strong></div>
            <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Khung giờ</th><th>Trạng thái</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in allSlots)
                        {
                            <tr class="@(s.IsActive ? "" : "table-secondary")">
                                <td>@s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm")</td>
                                <td>
                                    @if (s.IsActive)
                                    {
                                        <span class="badge bg-success">Mở</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Tắt</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-action="ToggleTimeSlot" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="fieldId" value="@Model.FieldId" />
                                        <input type="hidden" name="timeSlotId" value="@s.TimeSlotId" />
                                        <button class="btn btn-sm @(s.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                            @(s.IsActive ? "Tắt" : "Mở")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-body border-top">
                <form method="post" asp-action="AddTimeSlot" class="row g-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fieldId" value="@Model.FieldId" />
                    <div class="col-5">
                        <input name="startTime" type="time" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-5">
                        <input name="endTime" type="time" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-2">
                        <button class="btn btn-sm btn-success w-100"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </form>
                <small class="text-muted">Khung giờ đã có booking không xóa được - chỉ tắt để ngừng nhận đặt mới.</small>
            </div>
        </div>
    </div>
</div>
