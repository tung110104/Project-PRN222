@model Field
@{
    ViewData["Title"] = Model.FieldName;
    var selectedDate = (DateOnly)ViewBag.SelectedDate;
    var bookedIds = (List<int>)ViewBag.BookedSlotIds;
    var avg = (double)ViewBag.AvgRating;
    var slotPrices = (Dictionary<int, decimal>)ViewBag.SlotPrices;
    var goldenDay = ViewBag.GoldenDay as GoldenDay;
    var today = DateOnly.FromDateTime(DateTime.Now);
    var now = TimeOnly.FromDateTime(DateTime.Now);
    var canBook = User.Identity?.IsAuthenticated == true && !User.IsInRole("SuperAdmin");
}

<div class="row g-4">
    <div class="col-md-5">
        @{
            var images = Model.FieldImages.OrderByDescending(i => i.IsPrimary).ThenBy(i => i.ImageId).ToList();
        }
        @if (images.Any())
        {
            <div id="fieldCarousel" class="carousel slide mb-4 shadow-sm rounded overflow-hidden">
                <div class="carousel-inner">
                    @for (var i = 0; i < images.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@images[i].ImageUrl" class="d-block w-100" alt="@Model.FieldName"
                                 style="height:280px;object-fit:cover"
                                 onerror="this.onerror=null;this.src='/images/field-placeholder.svg'" />
                        </div>
                    }
                </div>
                @if (images.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#fieldCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#fieldCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                    <div class="carousel-indicators">
                        @for (var i = 0; i < images.Count; i++)
                        {
                            <button type="button" data-bs-target="#fieldCarousel" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")"></button>
                        }
                    </div>
                }
            </div>
        }
        <div class="card shadow-sm">
            <div class="card-body">
                <span class="badge bg-success mb-2">@Model.FieldType.TypeName</span>
                @if (Model.AcceptWalletPayment)
                {
                    <span class="badge bg-primary mb-2"><i class="bi bi-wallet2"></i> Nhận ví tiền ảo</span>
                    @if (Model.CashbackPercent > 0)
                    {
                        <span class="badge bg-info text-dark mb-2">Cashback @Model.CashbackPercent%</span>
                    }
                }
                <h3>@Model.FieldName</h3>
                @if (avg > 0)
                {
                    <p class="text-warning mb-1"><i class="bi bi-star-fill"></i> @avg.ToString("0.0") / 5 (@Model.Reviews.Count đánh giá)</p>
                }
                <p class="text-muted"><i class="bi bi-geo-alt"></i> @Model.Address, @Model.Ward, @Model.Province</p>
                <p>@Model.Description</p>
                <hr />
                <p class="mb-1">Giá cơ bản: <strong class="text-success">@Model.PricePerHour.ToString("N0")đ/giờ</strong></p>
                <p class="mb-0 text-muted small">Giá từng khung giờ hiển thị bên phải - tính theo bảng giá chi tiết (giờ / ngày / mùa).</p>
            </div>
        </div>

        <div class="card shadow-sm mt-4">
            <div class="card-header bg-white"><strong><i class="bi bi-chat-left-text"></i> Đánh giá</strong></div>
            <div class="card-body">
                @if (!Model.Reviews.Any())
                {
                    <p class="text-muted mb-0">Chưa có đánh giá nào.</p>
                }
                @foreach (var r in Model.Reviews.OrderByDescending(x => x.CreatedAt))
                {
                    <div class="border-bottom pb-2 mb-2">
                        <strong>@r.User.FullName</strong>
                        <span class="text-warning ms-2">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                            }
                        </span>
                        <p class="mb-0">@r.Comment</p>
                        <small class="text-muted">@r.CreatedAt.ToString("dd/MM/yyyy")</small>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong><i class="bi bi-calendar3"></i> Chọn khung giờ - @selectedDate.ToString("dd/MM/yyyy")</strong></div>
            <div class="card-body">
                <form method="get" class="row g-2 mb-3">
                    <input type="hidden" name="id" value="@Model.FieldId" />
                    <div class="col-auto">
                        <input type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")"
                               min="@today.ToString("yyyy-MM-dd")" class="form-control" onchange="this.form.submit()" />
                    </div>
                </form>

                @if (goldenDay != null)
                {
                    <div class="alert alert-warning py-2">
                        <i class="bi bi-star-fill"></i> <strong>Ngày vàng: @goldenDay.Name</strong> -
                        giá x@(goldenDay.PriceMultiplier.ToString("0.##")), tích điểm x@(goldenDay.PointsMultiplier)!
                    </div>
                }

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="alert alert-warning">
                        Vui lòng <a asp-controller="Account" asp-action="Login">đăng nhập</a> để đặt sân.
                    </div>
                }

                <form method="post" asp-controller="Field" asp-action="Book">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fieldId" value="@Model.FieldId" />
                    <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />

                    <div class="row row-cols-2 row-cols-lg-4 g-2 mb-3">
                        @foreach (var slot in Model.TimeSlots.OrderBy(s => s.StartTime))
                        {
                            var isBooked = bookedIds.Contains(slot.TimeSlotId);
                            var isPast = selectedDate == today && slot.StartTime <= now;
                            var price = slotPrices.TryGetValue(slot.TimeSlotId, out var p) ? p : Model.PricePerHour;
                            var isSpecial = price != Model.PricePerHour;
                            <div class="col">
                                @if (isBooked || isPast)
                                {
                                    <div class="border rounded p-2 text-center bg-secondary-subtle text-muted">
                                        <div>@slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")</div>
                                        <small>@(isBooked ? "Đã đặt" : "Đã qua")</small>
                                    </div>
                                }
                                else
                                {
                                    <label class="border rounded p-2 text-center d-block slot-label" style="cursor:pointer">
                                        <input type="checkbox" name="timeSlotIds" value="@slot.TimeSlotId"
                                               class="form-check-input me-1" data-price="@price" />
                                        <span>@slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")</span>
                                        <div><small class="@(isSpecial ? "text-danger" : "text-success")">@price.ToString("N0")đ</small></div>
                                    </label>
                                }
                            </div>
                        }
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <input name="promoCode" class="form-control" placeholder="Mã giảm giá (nếu có)" />
                        </div>
                        <div class="col-md-6">
                            <input name="note" class="form-control" placeholder="Ghi chú" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Tạm tính: <span id="total" class="text-success">0đ</span></h5>
                        <button class="btn btn-success" @(canBook ? "" : "disabled")>
                            <i class="bi bi-calendar-check"></i> Đặt sân
                        </button>
                    </div>
                    <p class="text-muted small mt-2 mb-0">
                        * Giảm giá theo hạng thành viên và mã khuyến mãi sẽ được trừ khi tạo booking;
                        điểm tích lũy có thể dùng ở bước thanh toán.
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('input[name="timeSlotIds"]').forEach(cb => {
            cb.addEventListener('change', () => {
                let total = 0;
                document.querySelectorAll('input[name="timeSlotIds"]:checked')
                    .forEach(c => total += parseFloat(c.dataset.price));
                document.getElementById('total').textContent = total.toLocaleString('vi-VN') + 'đ';
            });
        });
    </script>
}
