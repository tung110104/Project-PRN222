@model Field
@{
    ViewData["Title"] = Model.FieldName;
    var selectedDate = (DateOnly)ViewBag.SelectedDate;
    var bookedIds = (List<int>)ViewBag.BookedSlotIds;
    var slotPrices = (Dictionary<int, decimal>)ViewBag.SlotPrices;
    var goldenDay = ViewBag.GoldenDay as GoldenDay;
    var avg = (double)ViewBag.AvgRating;
    var today = DateOnly.FromDateTime(DateTime.Now);
    var now = TimeOnly.FromDateTime(DateTime.Now);
}

<div class="row g-4">
    <div class="col-md-5">
        <!-- Gallery ảnh sân -->
        <div class="card shadow-sm mb-4 overflow-hidden">
            @if (Model.FieldImages.Any())
            {
                var primary = Model.FieldImages.FirstOrDefault(i => i.IsPrimary) ?? Model.FieldImages.First();
                <img src="@primary.ImageUrl" class="w-100" style="height:240px;object-fit:cover" alt="@Model.FieldName" />
                @if (Model.FieldImages.Count > 1)
                {
                    <div class="d-flex gap-1 p-2 flex-wrap">
                        @foreach (var img in Model.FieldImages)
                        {
                            <img src="@img.ImageUrl" style="width:64px;height:48px;object-fit:cover" class="rounded border" />
                        }
                    </div>
                }
            }
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <span class="badge bg-success mb-2">@Model.FieldType.TypeName</span>
                <h3>@Model.FieldName</h3>
                @if (avg > 0)
                {
                    <p class="text-warning mb-1"><i class="bi bi-star-fill"></i> @avg.ToString("0.0") / 5 (@Model.Reviews.Count đánh giá)</p>
                }
                <p class="text-muted"><i class="bi bi-geo-alt"></i> @Model.Street, @Model.WardName, @Model.ProvinceName</p>
                <p>@Model.Description</p>
                <hr />
                <p class="mb-1">Giá mặc định: <strong class="text-success">@Model.PricePerHour.ToString("N0")đ/giờ</strong></p>
                @if (Model.PricingRules.Any(r => r.IsActive))
                {
                    <p class="mb-1 small text-muted">Bảng giá riêng theo khung giờ/ngày — giá từng khung hiển thị bên phải.</p>
                }
                @if (Model.AcceptWalletPayment)
                {
                    <span class="badge bg-info"><i class="bi bi-wallet2"></i> Nhận thanh toán ví@(Model.CashbackPercent > 0 ? $" · cashback {Model.CashbackPercent}%" : "")</span>
                }
            </div>
        </div>

        <div class="card shadow-sm mt-4">
            <div class="card-header bg-white"><strong><i class="bi bi-chat-left-text"></i> Đánh giá</strong></div>
            <div class="card-body">
                @if (!Model.Reviews.Any())
                {
                    <p class="text-muted mb-0">Chưa có đánh giá nào.</p>
                }
                @foreach (var r in Model.Reviews.OrderByDescending(x => x.CreatedAt))
                {
                    <div class="border-bottom pb-2 mb-2">
                        <strong>@r.User.FullName</strong>
                        <span class="text-warning ms-2">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                            }
                        </span>
                        <p class="mb-0">@r.Comment</p>
                        <small class="text-muted">@r.CreatedAt.ToString("dd/MM/yyyy")</small>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong><i class="bi bi-calendar3"></i> Chọn khung giờ - @selectedDate.ToString("dd/MM/yyyy")</strong></div>
            <div class="card-body">
                <form method="get" class="row g-2 mb-3">
                    <input type="hidden" name="id" value="@Model.FieldId" />
                    <div class="col-auto">
                        <input type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")"
                               min="@today.ToString("yyyy-MM-dd")" class="form-control" onchange="this.form.submit()" />
                    </div>
                </form>

                @if (goldenDay != null)
                {
                    <div class="alert alert-warning py-2">
                        <i class="bi bi-stars"></i> <strong>Ngày vàng: @goldenDay.Name</strong> —
                        nhân điểm ×@goldenDay.PointMultiplier@(goldenDay.DiscountPercent > 0 ? $", ưu đãi {goldenDay.DiscountPercent}% (đã trừ vào giá)" : "")
                    </div>
                }

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="alert alert-warning">
                        Vui lòng <a asp-controller="Account" asp-action="Login">đăng nhập</a> để đặt sân.
                    </div>
                }

                <form method="post" asp-controller="Field" asp-action="Book">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fieldId" value="@Model.FieldId" />
                    <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />

                    <p class="small text-muted mb-2">Mỗi lượt đặt chọn <strong>một</strong> khung giờ (muốn nhiều khung, đặt nhiều lượt).</p>
                    <div class="row row-cols-2 row-cols-lg-4 g-2 mb-3">
                        @foreach (var slot in Model.TimeSlots.OrderBy(s => s.StartTime))
                        {
                            var isBooked = bookedIds.Contains(slot.TimeSlotId);
                            var isPast = selectedDate == today && slot.StartTime <= now;
                            var price = slotPrices.TryGetValue(slot.TimeSlotId, out var p) ? p : Model.PricePerHour;
                            var isSpecial = price != Model.PricePerHour;
                            <div class="col">
                                @if (isBooked || isPast)
                                {
                                    <div class="border rounded p-2 text-center bg-secondary-subtle text-muted">
                                        <div>@slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")</div>
                                        <small>@(isBooked ? "Đã đặt" : "Đã qua")</small>
                                    </div>
                                }
                                else
                                {
                                    <label class="border rounded p-2 text-center d-block" style="cursor:pointer">
                                        <input type="radio" name="timeSlotId" value="@slot.TimeSlotId"
                                               class="form-check-input me-1" data-price="@price" required />
                                        <span>@slot.StartTime.ToString("HH:mm") - @slot.EndTime.ToString("HH:mm")</span>
                                        <div><small class="@(isSpecial ? "text-danger" : "text-success")">@price.ToString("N0")đ</small></div>
                                    </label>
                                }
                            </div>
                        }
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <input name="promoCode" class="form-control" placeholder="Mã giảm giá (nếu có)" />
                        </div>
                        <div class="col-md-4">
                            <input name="pointsToUse" type="number" min="0" step="100" value="0" class="form-control"
                                   placeholder="Điểm quy đổi" title="Bội số 100 điểm; 100 điểm = 10.000đ" />
                        </div>
                        <div class="col-md-4">
                            <input name="note" class="form-control" placeholder="Ghi chú" />
                        </div>
                    </div>

                    @if (ViewBag.MyPoints != null)
                    {
                        <p class="small text-muted mb-2">
                            <i class="bi bi-coin"></i> Bạn có <strong>@ViewBag.MyPoints điểm</strong>
                            · Hạng <strong>@ViewBag.MyTier</strong>@(ViewBag.MyTierPercent > 0 ? $" (tự động giảm {ViewBag.MyTierPercent}%)" : "")
                        </p>
                    }

                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Giá khung đã chọn: <span id="total" class="text-success">0đ</span></h5>
                        <button class="btn btn-success" @(User.Identity?.IsAuthenticated != true ? "disabled" : "")>
                            <i class="bi bi-calendar-check"></i> Đặt sân
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('input[name="timeSlotId"]').forEach(rb => {
            rb.addEventListener('change', () => {
                const price = parseFloat(rb.dataset.price) || 0;
                document.getElementById('total').textContent = price.toLocaleString('vi-VN') + 'đ';
            });
        });
    </script>
}
