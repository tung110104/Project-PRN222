@model List<MaintenanceRequest>
@{
    ViewData["Title"] = "Yêu cầu bảo trì";
    var fields = (List<Field>)ViewBag.Fields;
    var today = DateOnly.FromDateTime(DateTime.Now);
}
<h3 class="mb-4"><i class="bi bi-tools"></i> Yêu cầu bảo trì sân</h3>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Gửi yêu cầu mới</strong></div>
            <div class="card-body">
                <form method="post" asp-action="Create">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Sân *</label>
                        <select name="fieldId" class="form-select" required>
                            @foreach (var f in fields)
                            {
                                <option value="@f.FieldId">@f.FieldName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Từ ngày *</label>
                        <input name="startDate" type="date" min="@today.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Đến ngày *</label>
                        <input name="endDate" type="date" min="@today.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lý do *</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="VD: Thay cỏ nhân tạo, sửa hệ thống đèn..." required></textarea>
                    </div>
                    <button class="btn btn-success w-100"><i class="bi bi-send"></i> Gửi yêu cầu</button>
                </form>
                <p class="text-muted small mt-2 mb-0">
                    * Khi Admin duyệt: sân khóa đặt trong khoảng bảo trì, booking trùng lịch tự hủy +
                    hoàn tiền (về ví nếu trả bằng ví) + email thông báo cho khách.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Các yêu cầu đã gửi</strong></div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Sân</th><th>Thời gian</th><th>Lý do</th><th>Trạng thái</th><th>Phản hồi Admin</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td>@m.MaintenanceRequestId</td>
                                <td>@m.Field.FieldName</td>
                                <td>@m.StartDate.ToString("dd/MM") - @m.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>@m.Reason</td>
                                <td>
                                    @switch (m.Status)
                                    {
                                        case "Pending": <span class="badge bg-warning text-dark">Chờ duyệt</span>; break;
                                        case "Approved": <span class="badge bg-success">Đã duyệt</span>; break;
                                        case "Rejected": <span class="badge bg-danger">Từ chối</span>; break;
                                    }
                                </td>
                                <td><small class="text-muted">@m.AdminNote</small></td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted">Chưa có yêu cầu bảo trì nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
