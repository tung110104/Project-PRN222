@model List<MaintenanceRequest>
@{
    ViewData["Title"] = "Duyệt bảo trì";
    var status = ViewBag.Status as string;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-tools"></i> Duyệt yêu cầu bảo trì</h3>
    <form method="get">
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">Tất cả trạng thái</option>
            <option value="Pending" selected="@(status == "Pending")">Chờ duyệt</option>
            <option value="Approved" selected="@(status == "Approved")">Đã duyệt</option>
            <option value="Rejected" selected="@(status == "Rejected")">Từ chối</option>
        </select>
    </form>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th><th>Sân</th><th>Chủ sân</th><th>Thời gian</th><th>Lý do</th><th>Trạng thái</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.MaintenanceRequestId</td>
                        <td>@m.Field.FieldName</td>
                        <td>@m.Owner.FullName<br /><small class="text-muted">@m.Owner.Email</small></td>
                        <td>@m.StartDate.ToString("dd/MM") - @m.EndDate.ToString("dd/MM/yyyy")</td>
                        <td>@m.Reason</td>
                        <td>
                            @switch (m.Status)
                            {
                                case "Pending": <span class="badge bg-warning text-dark">Chờ duyệt</span>; break;
                                case "Approved": <span class="badge bg-success">Đã duyệt</span>; break;
                                case "Rejected": <span class="badge bg-danger">Từ chối</span>; break;
                            }
                            @if (m.AdminNote != null)
                            {
                                <br /><small class="text-muted">@m.AdminNote</small>
                            }
                        </td>
                        <td class="text-end" style="min-width:260px">
                            @if (m.Status == "Pending")
                            {
                                <form method="post" asp-action="Approve" asp-route-id="@m.MaintenanceRequestId" class="d-flex gap-1 mb-1"
                                      onsubmit="return confirm('Duyệt bảo trì? Booking trùng lịch sẽ bị hủy, hoàn tiền và gửi email cho khách.')">
                                    @Html.AntiForgeryToken()
                                    <input name="adminNote" class="form-control form-control-sm" placeholder="Ghi chú (tùy chọn)" />
                                    <button class="btn btn-sm btn-success">Duyệt</button>
                                </form>
                                <form method="post" asp-action="Reject" asp-route-id="@m.MaintenanceRequestId" class="d-flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input name="adminNote" class="form-control form-control-sm" placeholder="Lý do từ chối" />
                                    <button class="btn btn-sm btn-outline-danger">Từ chối</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="card-body text-center text-muted">Không có yêu cầu bảo trì nào.</div>
    }
</div>
