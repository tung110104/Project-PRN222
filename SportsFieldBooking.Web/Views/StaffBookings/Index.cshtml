@model List<Booking>
@{
    ViewData["Title"] = "Quản lý đặt lịch";
    var status = ViewBag.Status as string;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-calendar-week"></i> Quản lý đặt lịch</h3>
    <div class="d-flex gap-2">
        <a asp-action="BookFor" class="btn btn-success"><i class="bi bi-person-plus"></i> Đặt hộ khách</a>
        <form method="get">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">Tất cả trạng thái</option>
                <option value="Pending" selected="@(status == "Pending")">Chờ xác nhận</option>
                <option value="Confirmed" selected="@(status == "Confirmed")">Đã xác nhận</option>
                <option value="Completed" selected="@(status == "Completed")">Hoàn thành</option>
                <option value="Cancelled" selected="@(status == "Cancelled")">Đã hủy</option>
            </select>
        </form>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <form method="post" asp-action="UploadQr" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
                @Html.AntiForgeryToken()
                <label class="form-label mb-0 small">Ảnh QR Momo thanh toán:</label>
                <input type="file" name="qrImage" class="form-control form-control-sm w-auto" accept="image/*" />
                <button class="btn btn-sm btn-outline-primary">Cập nhật QR</button>
            </form>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Khách hàng</th>
                    <th>Sân</th>
                    <th>Ngày đá</th>
                    <th>Khung giờ</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.BookingId</td>
                        <td>
                            @if (!string.IsNullOrEmpty(b.GuestName))
                            {
                                <span>@b.GuestName <span class="badge bg-secondary">vãng lai</span></span>
                                <br /><small class="text-muted">@b.GuestPhone</small>
                            }
                            else
                            {
                                @b.User.FullName
                                <br /><small class="text-muted">@b.User.Email</small>
                            }
                            @if (b.CreatedBy != null)
                            {
                                <br /><small class="text-info">đặt hộ bởi @b.CreatedBy.FullName</small>
                            }
                        </td>
                        <td>@b.Field.FieldName</td>
                        <td>@b.BookingDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @b.TimeSlot.StartTime.ToString("HH:mm") - @b.TimeSlot.EndTime.ToString("HH:mm")
                            </span>
                        </td>
                        <td class="text-success fw-bold">@b.TotalAmount.ToString("N0")đ</td>
                        <td>
                            @if (b.Payments.Any(p => p.Status == "Paid"))
                            {
                                var pm = b.Payments.First(p => p.Status == "Paid");
                                <span class="badge bg-success">Đã TT (@pm.Method)</span>
                            }
                            else if (b.Payments.Any(p => p.Status == "Pending"))
                            {
                                <span class="badge bg-info">Chờ duyệt TT</span>
                            }
                            else if (b.Payments.Any(p => p.Status == "RefundPending"))
                            {
                                <span class="badge bg-warning text-dark">Chờ hoàn tiền</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chưa TT</span>
                            }
                        </td>
                        <td>
                            @switch (b.Status)
                            {
                                case "Pending": <span class="badge bg-warning text-dark">Chờ</span>; break;
                                case "Confirmed": <span class="badge bg-primary">Xác nhận</span>; break;
                                case "Completed": <span class="badge bg-success">Hoàn thành</span>; break;
                                case "Cancelled": <span class="badge bg-danger">Hủy</span>; break;
                            }
                        </td>
                        <td class="text-end">
                            @if (b.Status == "Pending")
                            {
                                <form method="post" asp-action="Confirm" asp-route-id="@b.BookingId" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-primary">Xác nhận</button>
                                </form>
                            }
                            @if (b.Status is "Pending" or "Confirmed")
                            {
                                <form method="post" asp-action="Cancel" asp-route-id="@b.BookingId" class="d-inline"
                                      onsubmit="return confirm('Hủy booking này?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">Hủy</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="card-body text-center text-muted">Không có booking nào.</div>
    }
</div>
