@model List<Booking>
@{
    ViewData["Title"] = "Quản lý đặt lịch";
    var status = ViewBag.Status as string;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-calendar-week"></i> Quản lý đặt lịch</h3>
    <form method="get">
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">Tất cả trạng thái</option>
            <option value="Pending" selected="@(status == "Pending")">Chờ xác nhận</option>
            <option value="Confirmed" selected="@(status == "Confirmed")">Đã xác nhận</option>
            <option value="Completed" selected="@(status == "Completed")">Hoàn thành</option>
            <option value="Cancelled" selected="@(status == "Cancelled")">Đã hủy</option>
        </select>
    </form>
</div>

@if (User.IsInRole("Admin"))
{
    var qrPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "images", "momo-qr.png");
    var hasQr = System.IO.File.Exists(qrPath);
    <div class="card shadow-sm mb-4 border-success">
        <div class="card-header bg-white"><strong><i class="bi bi-qr-code"></i> Ảnh QR Momo thanh toán (chỉ Admin)</strong></div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-3 text-center mb-3 mb-md-0">
                    @if (hasQr)
                    {
                        <img src="~/images/momo-qr.png?v=@DateTime.Now.Ticks" alt="QR Momo hiện tại" class="img-fluid border rounded" style="max-width: 160px;" />
                        <div class="small text-muted mt-1">Ảnh QR hiện tại</div>
                    }
                    else
                    {
                        <div class="text-muted small">Chưa có ảnh QR nào.</div>
                    }
                </div>
                <div class="col-md-9">
                    <form method="post" asp-action="UploadQr" enctype="multipart/form-data" class="row g-2 align-items-center">
                        @Html.AntiForgeryToken()
                        <div class="col-sm-8">
                            <input type="file" name="qrImage" class="form-control" accept=".png,.jpg,.jpeg" required />
                        </div>
                        <div class="col-sm-4">
                            <button type="submit" class="btn btn-success w-100"><i class="bi bi-upload"></i> Tải ảnh QR lên</button>
                        </div>
                        <div class="col-12"><small class="text-muted">Chọn ảnh QR Momo (PNG/JPG). Ảnh sẽ tự động hiển thị ở trang thanh toán của khách.</small></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Khách hàng</th>
                    <th>Sân</th>
                    <th>Ngày đá</th>
                    <th>Khung giờ</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    var detail = b.BookingDetails.FirstOrDefault();
                    <tr>
                        <td>@b.BookingId</td>
                        <td>@b.User.FullName<br /><small class="text-muted">@b.User.Email</small></td>
                        <td>@detail?.Field.FieldName</td>
                        <td>@detail?.BookingDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @foreach (var d in b.BookingDetails.OrderBy(x => x.TimeSlot.StartTime))
                            {
                                <span class="badge bg-light text-dark border">@d.TimeSlot.StartTime.ToString("HH:mm")</span>
                            }
                        </td>
                        <td class="text-success fw-bold">@b.TotalAmount.ToString("N0")đ</td>
                        <td>
                            @if (b.Payments.Any(p => p.Status == "Paid"))
                            {
                                <span class="badge bg-success">Đã TT</span>
                            }
                            else if (b.Payments.Any(p => p.Status == "Pending"))
                            {
                                <span class="badge bg-info text-dark" title="Khách báo đã chuyển khoản, chờ kiểm tra">Chờ xác nhận</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chưa TT</span>
                            }
                        </td>
                        <td>
                            @switch (b.Status)
                            {
                                case "Pending": <span class="badge bg-warning text-dark">Chờ</span>; break;
                                case "Confirmed": <span class="badge bg-primary">Xác nhận</span>; break;
                                case "Completed": <span class="badge bg-success">Hoàn thành</span>; break;
                                case "Cancelled": <span class="badge bg-danger">Hủy</span>; break;
                            }
                        </td>
                        <td class="text-end">
                            @if (b.Status == "Pending")
                            {
                                <form method="post" asp-action="Confirm" asp-route-id="@b.BookingId" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-primary">Xác nhận</button>
                                </form>
                            }
                            @if (b.Status is "Pending" or "Confirmed")
                            {
                                <form method="post" asp-action="Cancel" asp-route-id="@b.BookingId" class="d-inline"
                                      onsubmit="return confirm('Hủy booking này?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">Hủy</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="card-body text-center text-muted">Không có booking nào.</div>
    }
</div>
