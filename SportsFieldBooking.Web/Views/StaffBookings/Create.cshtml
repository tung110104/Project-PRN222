@{
    ViewData["Title"] = "Đặt hộ khách";
    var fields = (List<Field>)ViewBag.Fields;
    var customers = (List<User>)ViewBag.Customers;
    var today = DateOnly.FromDateTime(DateTime.Now);
}
<h3 class="mb-4"><i class="bi bi-person-plus"></i> Đặt sân hộ khách (walk-in / điện thoại)</h3>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label class="form-label">Khách hàng *</label>
                        <select name="customerId" class="form-select" required>
                            <option value="">-- Chọn khách hàng --</option>
                            @foreach (var c in customers)
                            {
                                <option value="@c.UserId">@c.FullName (@c.Email)</option>
                            }
                        </select>
                        <small class="text-muted">Khách vãng lai chưa có tài khoản: tạo tài khoản ở trang Đăng ký trước.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Sân *</label>
                        <select name="fieldId" id="fieldSelect" class="form-select" required>
                            <option value="">-- Chọn sân --</option>
                            @foreach (var f in fields.Where(f => f.Status == "Active"))
                            {
                                <option value="@f.FieldId">@f.FieldName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày đá *</label>
                        <input name="date" id="dateInput" type="date" value="@today.ToString("yyyy-MM-dd")"
                               min="@today.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Khung giờ trống *</label>
                        <select name="timeSlotIds" id="slotSelect" class="form-select" multiple size="5" required>
                            <option value="">-- Chọn sân và ngày trước --</option>
                        </select>
                        <small class="text-muted">Giữ Ctrl để chọn nhiều khung giờ.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Mã khuyến mãi</label>
                        <input name="promoCode" class="form-control" placeholder="Nếu khách có mã" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ghi chú</label>
                        <input name="note" class="form-control" placeholder="VD: Khách gọi điện lúc 9h" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="cashPaid" value="true" id="cashPaid" />
                            <label class="form-check-label" for="cashPaid">
                                Khách đã trả tiền mặt tại quầy (ghi nhận thanh toán Cash luôn)
                            </label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-success"><i class="bi bi-calendar-check"></i> Tạo booking</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Chon san + ngay -> tai khung gio trong tu server (AvailableSlots tra JSON)
        const fieldSelect = document.getElementById('fieldSelect');
        const dateInput = document.getElementById('dateInput');
        const slotSelect = document.getElementById('slotSelect');

        async function loadSlots() {
            if (!fieldSelect.value || !dateInput.value) return;
            slotSelect.innerHTML = '<option>Đang tải...</option>';
            const res = await fetch(`/StaffBookings/AvailableSlots?fieldId=${fieldSelect.value}&date=${dateInput.value}`);
            const slots = await res.json();
            slotSelect.innerHTML = slots.length
                ? slots.map(s => `<option value="${s.timeSlotId}">${s.start} - ${s.end}</option>`).join('')
                : '<option value="">Không còn khung giờ trống</option>';
        }
        fieldSelect.addEventListener('change', loadSlots);
        dateInput.addEventListener('change', loadSlots);
    </script>
}
