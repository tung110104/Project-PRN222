@model List<User>
@{
    ViewData["Title"] = "Quản lý người dùng";
    var roles = (List<Role>)ViewBag.Roles;
    var isSuper = User.IsInRole("SuperAdmin");
}
<h3 class="mb-4"><i class="bi bi-people"></i> Quản lý người dùng</h3>

@if (isSuper)
{
    <div class="alert alert-danger py-2">
        <i class="bi bi-shield-lock"></i> Bạn đang dùng <strong>Super Account</strong> (tài khoản cứu hộ, không lưu trong database).
        Dùng nút "Cấp Admin" / "Thu hồi Admin" để khôi phục quyền quản trị khi tài khoản admin bị mất.
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Ví / Điểm</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var tier = SportsFieldBooking.Business.Patterns.MembershipTiers.GetTier(u.LifetimePoints);
                    <tr>
                        <td>@u.UserId</td>
                        <td>@u.FullName<br /><small class="text-muted">@u.Phone</small></td>
                        <td>@u.Email</td>
                        <td>
                            @if (isSuper)
                            {
                                @* Super account chi cap/thu hoi Admin - khong doi role tuy y *@
                                <span class="badge bg-light text-dark border">@u.Role.RoleName</span>
                            }
                            else
                            {
                                <form method="post" asp-action="ChangeRole" asp-route-id="@u.UserId" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <select name="roleId" class="form-select form-select-sm d-inline w-auto" onchange="this.form.submit()">
                                        @foreach (var r in roles)
                                        {
                                            <option value="@r.RoleId" selected="@(u.RoleId == r.RoleId)">@r.RoleName</option>
                                        }
                                    </select>
                                </form>
                            }
                        </td>
                        <td>
                            <small>
                                <i class="bi bi-wallet2"></i> @((u.Wallet?.Balance ?? 0).ToString("N0"))đ<br />
                                <i class="bi bi-stars"></i> @u.Points điểm
                                <span class="badge @tier.BadgeCss">@tier.Name</span>
                            </small>
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đã khóa</span>
                            }
                        </td>
                        <td class="text-end" style="min-width:280px">
                            @if (u.Role.RoleName == "Admin")
                            {
                                <form method="post" asp-action="SetAdmin" class="d-inline"
                                      onsubmit="return confirm('Thu hồi quyền Admin của @u.Email?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.UserId" />
                                    <input type="hidden" name="grant" value="false" />
                                    <button class="btn btn-sm btn-outline-danger">Thu hồi Admin</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="SetAdmin" class="d-inline"
                                      onsubmit="return confirm('Cấp quyền Admin cho @u.Email?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.UserId" />
                                    <input type="hidden" name="grant" value="true" />
                                    <button class="btn btn-sm btn-outline-success">Cấp Admin</button>
                                </form>
                            }
                            <form method="post" asp-action="ToggleActive" asp-route-id="@u.UserId" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(u.IsActive ? "Khóa" : "Mở khóa")
                                </button>
                            </form>
                            @if (!isSuper)
                            {
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#adjust-@u.UserId">
                                    Ví/Điểm
                                </button>
                            }
                        </td>
                    </tr>
                    @if (!isSuper)
                    {
                        <tr class="collapse" id="adjust-@u.UserId">
                            <td colspan="7" class="bg-light">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <form method="post" asp-action="AdjustWallet" asp-route-id="@u.UserId" class="d-flex gap-2">
                                            @Html.AntiForgeryToken()
                                            <span class="align-self-center small text-nowrap">Ví:</span>
                                            <input name="amount" type="number" step="1000" class="form-control form-control-sm"
                                                   placeholder="+/- số tiền (đ)" required />
                                            <input name="reason" class="form-control form-control-sm" placeholder="Lý do (bắt buộc)" required />
                                            <button class="btn btn-sm btn-primary text-nowrap">Điều chỉnh ví</button>
                                        </form>
                                    </div>
                                    <div class="col-md-6">
                                        <form method="post" asp-action="AdjustPoints" asp-route-id="@u.UserId" class="d-flex gap-2">
                                            @Html.AntiForgeryToken()
                                            <span class="align-self-center small text-nowrap">Điểm:</span>
                                            <input name="points" type="number" class="form-control form-control-sm"
                                                   placeholder="+/- điểm" required />
                                            <input name="reason" class="form-control form-control-sm" placeholder="Lý do (bắt buộc)" required />
                                            <button class="btn btn-sm btn-warning text-nowrap">Điều chỉnh điểm</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
