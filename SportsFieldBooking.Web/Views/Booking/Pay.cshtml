@model Booking
@{
    ViewData["Title"] = "Thanh toán";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong><i class="bi bi-credit-card"></i> Thanh toán booking #@Model.BookingId</strong></div>
            <div class="card-body">
                <h4 class="text-center mb-4">Số tiền: <span class="text-success">@Model.TotalAmount.ToString("N0")đ</span></h4>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.BookingId" />
                    <div class="list-group mb-3">
                        <label class="list-group-item d-flex gap-2">
                            <input class="form-check-input" type="radio" name="method" value="VNPay" checked />
                            <span><strong>VNPay</strong> — Ví điện tử / thẻ ATM (sandbox)</span>
                        </label>
                        <label class="list-group-item d-flex gap-2">
                            <input class="form-check-input" type="radio" name="method" value="Momo" />
                            <span><strong>Momo</strong> — Ví Momo (sandbox)</span>
                        </label>
                        <label class="list-group-item d-flex gap-2">
                            <input class="form-check-input" type="radio" name="method" value="Cash" />
                            <span><strong>Tiền mặt</strong> — Thanh toán tại sân</span>
                        </label>
                    </div>
                    <button class="btn btn-success w-100"><i class="bi bi-check-circle"></i> Xác nhận thanh toán</button>
                </form>
                <p class="text-muted small text-center mt-3 mb-0">* Thanh toán mô phỏng phục vụ demo môn học.</p>
            </div>
        </div>
    </div>
</div>
