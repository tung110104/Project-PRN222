@model Booking

@{
    ViewData["Title"] = "Chi tiết booking #" + Model.BookingId;
    var paid = Model.Payments.Any(p => p.Status == "Paid");
    var payment = Model.Payments
        .OrderByDescending(p => p.PaymentId)
        .FirstOrDefault();
}

<style>
    .rating-stars {
        display: inline-flex;
        direction: rtl;
    }

        .rating-stars input {
            display: none;
        }

        .rating-stars label {
            color: #cccccc;
            cursor: pointer;
            font-size: 38px;
            line-height: 1;
            transition: color 0.15s ease;
        }

            .rating-stars input:checked ~ label,
            .rating-stars label:hover,
            .rating-stars label:hover ~ label {
                color: #ffc107;
            }
</style>

<h3 class="mb-4">
    <i class="bi bi-receipt"></i>
    Booking #@Model.BookingId
</h3>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <strong>Thông tin đặt sân</strong>
            </div>

            <div class="card-body">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Sân</th>
                            <th>Ngày</th>
                            <th>Khung giờ</th>
                            <th class="text-end">Giá</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var detail in Model.BookingDetails
                                                .OrderBy(x => x.TimeSlot.StartTime))
                        {
                            <tr>
                                <td>@detail.Field.FieldName</td>

                                <td>
                                    @detail.BookingDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @detail.TimeSlot.StartTime.ToString("HH:mm")
                                    -
                                    @detail.TimeSlot.EndTime.ToString("HH:mm")
                                </td>

                                <td class="text-end">
                                    @detail.Price.ToString("N0")đ
                                </td>

                                <td>
                                    @if (detail.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Hủy
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <hr />

                @if (Model.Promotion != null)
                {
                    <p class="mb-1">
                        Khuyến mãi:

                        <span class="badge bg-info">
                            @Model.Promotion.Code
                            (-@Model.Promotion.DiscountPercent%)
                        </span>
                    </p>
                }

                <h5>
                    Tổng tiền:

                    <span class="text-success">
                        @Model.TotalAmount.ToString("N0")đ
                    </span>
                </h5>

                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <p class="text-muted mb-0">
                        Ghi chú: @Model.Note
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <strong>Trạng thái &amp; thanh toán</strong>
            </div>

            <div class="card-body">
                <p>
                    Trạng thái:

                    @switch (Model.Status)
                    {
                        case "Pending":
                            <span class="badge bg-warning text-dark">
                                Chờ xác nhận
                            </span>
                            break;

                        case "Confirmed":
                            <span class="badge bg-primary">
                                Đã xác nhận
                            </span>
                            break;

                        case "Completed":
                            <span class="badge bg-success">
                                Hoàn thành
                            </span>
                            break;

                        case "Cancelled":
                            <span class="badge bg-danger">
                                Đã hủy
                            </span>
                            break;
                    }
                </p>

                @if (payment != null)
                {
                    <p class="mb-1">
                        Phương thức:
                        <strong>@payment.Method</strong>
                        (@payment.Status)
                    </p>

                    <p class="mb-1">
                        Mã giao dịch:
                        <code>@payment.TransactionCode</code>
                    </p>

                    @if (payment.PaidAt != null)
                    {
                        <p class="mb-0">
                            Thời gian:
                            @payment.PaidAt?.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    }
                }

                @if (!paid &&
                                Model.Status is "Pending" or "Confirmed")
                {
                    <a asp-action="Pay"
                       asp-route-id="@Model.BookingId"
                       class="btn btn-success w-100 mt-2">

                        <i class="bi bi-credit-card"></i>
                        Thanh toán ngay
                    </a>
                }

                @if (Model.Status is "Pending" or "Confirmed")
                {
                    <form method="post"
                          asp-action="Cancel"
                          asp-route-id="@Model.BookingId"
                          class="mt-2"
                          onsubmit="return confirm('Bạn chắc chắn muốn hủy booking này?')">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger w-100">

                            <i class="bi bi-x-circle"></i>
                            Hủy booking
                        </button>
                    </form>
                }
            </div>
        </div>

        @if (Model.Status == "Completed" &&
                Model.Review == null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <strong>
                        <i class="bi bi-star"></i>
                        Đánh giá sân
                    </strong>
                </div>

                <div class="card-body">
                    <form method="post"
                          asp-action="Review"
                          asp-route-id="@Model.BookingId">

                        @Html.AntiForgeryToken()

                        <div class="mb-3 text-center">
                            <p class="mb-2">Chọn mức đánh giá</p>

                            <div class="rating-stars">
                                @for (var star = 5;
                                                            star >= 1;
                                                            star--)
                                {
                                    <input type="radio"
                                           id="add-star-@star"
                                           name="rating"
                                           value="@star"
                                           required />

                                    <label for="add-star-@star"
                                           title="@star sao">
                                        <i class="bi bi-star-fill"></i>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Bình luận
                            </label>

                            <textarea name="comment"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000"
                                  placeholder="Chia sẻ trải nghiệm của bạn..."></textarea>

                            <div class="form-text">
                                Tối đa 1.000 ký tự.
                            </div>
                        </div>

                        <button type="submit"
                                class="btn btn-warning w-100">

                            <i class="bi bi-send"></i>
                            Gửi đánh giá
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (Model.Review != null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <strong>
                        <i class="bi bi-star-fill text-warning"></i>
                        Đánh giá của bạn
                    </strong>
                </div>

                <div class="card-body">
                    <form method="post"
                          asp-action="UpdateReview"
                          asp-route-id="@Model.BookingId">

                        @Html.AntiForgeryToken()

                        <div class="mb-3 text-center">
                            <div class="rating-stars">
                                @for (var star = 5;
                                                            star >= 1;
                                                            star--)
                                {
                                    if (star == Model.Review.Rating)
                                    {
                                        <input type="radio"
                                               id="edit-star-@star"
                                               name="rating"
                                               value="@star"
                                               checked
                                               required />
                                    }
                                    else
                                    {
                                        <input type="radio"
                                               id="edit-star-@star"
                                               name="rating"
                                               value="@star"
                                               required />
                                    }

                                    <label for="edit-star-@star"
                                           title="@star sao">
                                        <i class="bi bi-star-fill"></i>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Bình luận
                            </label>

                            <textarea name="comment"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1000">@Model.Review.Comment</textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="bi bi-save"></i>
                            Cập nhật đánh giá
                        </button>
                    </form>

                    <form method="post"
                          asp-action="DeleteReview"
                          asp-route-id="@Model.BookingId"
                          class="mt-2"
                          onsubmit="return confirm('Bạn chắc chắn muốn xóa đánh giá này?')">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger w-100">

                            <i class="bi bi-trash"></i>
                            Xóa đánh giá
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
