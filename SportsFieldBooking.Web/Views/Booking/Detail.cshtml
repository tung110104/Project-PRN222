@model Booking
@{
    ViewData["Title"] = "Chi tiết booking #" + Model.BookingId;
    var paid = Model.Payments.Any(p => p.Status == "Paid");
    var payment = Model.Payments.OrderByDescending(p => p.PaymentId).FirstOrDefault();
}

<style>
    .rating-stars { display: inline-flex; direction: rtl; }
    .rating-stars input { display: none; }
    .rating-stars label {
        color: #cccccc; cursor: pointer; font-size: 34px; line-height: 1;
        transition: color 0.15s ease;
    }
    .rating-stars input:checked ~ label,
    .rating-stars label:hover,
    .rating-stars label:hover ~ label { color: #ffc107; }
</style>

<h3 class="mb-4"><i class="bi bi-receipt"></i> Booking #@Model.BookingId</h3>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Thông tin đặt sân</strong></div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody>
                        <tr><th>Sân</th><td>@Model.Field.FieldName</td></tr>
                        <tr><th>Ngày đá</th><td>@Model.BookingDate.ToString("dd/MM/yyyy")</td></tr>
                        <tr><th>Khung giờ</th>
                            <td>@Model.TimeSlot.StartTime.ToString("HH:mm") - @Model.TimeSlot.EndTime.ToString("HH:mm")</td></tr>
                        @if (Model.CreatedBy != null)
                        {
                            <tr><th>Đặt hộ bởi</th>
                                <td>@Model.CreatedBy.FullName
                                    @if (!string.IsNullOrEmpty(Model.GuestName))
                                    {
                                        <span class="text-muted">(khách: @Model.GuestName @Model.GuestPhone)</span>
                                    }
                                </td></tr>
                        }
                    </tbody>
                </table>
                <hr />
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td>Giá gốc (theo bảng giá)</td><td class="text-end">@Model.UnitPrice.ToString("N0")đ</td></tr>
                        @if (Model.PromoDiscount > 0)
                        {
                            <tr><td>Mã khuyến mãi @(Model.Promotion != null ? $"({Model.Promotion.Code})" : "")</td>
                                <td class="text-end text-danger">−@Model.PromoDiscount.ToString("N0")đ</td></tr>
                        }
                        @if (Model.TierDiscount > 0)
                        {
                            <tr><td>Giảm giá hạng thành viên</td>
                                <td class="text-end text-danger">−@Model.TierDiscount.ToString("N0")đ</td></tr>
                        }
                        @if (Model.PointsDiscount > 0)
                        {
                            <tr><td>Quy đổi @Model.PointsUsed điểm</td>
                                <td class="text-end text-danger">−@Model.PointsDiscount.ToString("N0")đ</td></tr>
                        }
                        <tr class="fw-bold"><td>Phải thanh toán</td>
                            <td class="text-end text-success">@Model.TotalAmount.ToString("N0")đ</td></tr>
                    </tbody>
                </table>
                @if (Model.PointsEarned > 0)
                {
                    <p class="small text-muted mt-2 mb-0"><i class="bi bi-coin"></i> Đã tích @Model.PointsEarned điểm từ booking này.</p>
                }
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <p class="text-muted mt-2 mb-0">Ghi chú: @Model.Note</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white"><strong>Trạng thái &amp; Thanh toán</strong></div>
            <div class="card-body">
                <p>Trạng thái:
                    @switch (Model.Status)
                    {
                        case "Pending": <span class="badge bg-warning text-dark">Chờ xác nhận</span>; break;
                        case "Confirmed": <span class="badge bg-primary">Đã xác nhận</span>; break;
                        case "Completed": <span class="badge bg-success">Hoàn thành</span>; break;
                        case "Cancelled": <span class="badge bg-danger">Đã hủy</span>; break;
                    }
                </p>
                @if (payment != null)
                {
                    <p class="mb-1">Phương thức: <strong>@payment.Method</strong> (@payment.Status)</p>
                    <p class="mb-1">Mã giao dịch: <code>@payment.TransactionCode</code></p>
                    @if (payment.PaidAt != null)
                    {
                        <p class="mb-0">Thời gian: @payment.PaidAt?.ToString("dd/MM/yyyy HH:mm")</p>
                    }
                }

                @if (!paid && Model.Status is "Pending" or "Confirmed" &&
                     !Model.Payments.Any(p => p.Status == "Pending"))
                {
                    <a asp-action="Pay" asp-route-id="@Model.BookingId" class="btn btn-success w-100 mt-2">
                        <i class="bi bi-credit-card"></i> Thanh toán ngay
                    </a>
                }
                @if (Model.Status is "Pending" or "Confirmed")
                {
                    <form method="post" asp-action="Cancel" asp-route-id="@Model.BookingId" class="mt-2"
                          onsubmit="return confirm('Bạn chắc chắn muốn hủy booking này?')">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-danger w-100"><i class="bi bi-x-circle"></i> Hủy booking</button>
                    </form>
                }
            </div>
        </div>

        @if (Model.Status == "Completed" && Model.Review == null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white"><strong><i class="bi bi-star"></i> Đánh giá sân</strong></div>
                <div class="card-body">
                    <form method="post" asp-action="Review" asp-route-id="@Model.BookingId">
                        @Html.AntiForgeryToken()
                        <div class="mb-2 text-center rating-stars">
                            @for (var i = 5; i >= 1; i--)
                            {
                                <input type="radio" id="star-@i" name="rating" value="@i" @(i == 5 ? "checked" : "") />
                                <label for="star-@i"><i class="bi bi-star-fill"></i></label>
                            }
                        </div>
                        <div class="mb-2">
                            <textarea name="comment" class="form-control" rows="3" placeholder="Chia sẻ trải nghiệm của bạn..."></textarea>
                        </div>
                        <button class="btn btn-warning w-100">Gửi đánh giá (+điểm thưởng)</button>
                    </form>
                </div>
            </div>
        }
        @if (Model.Review != null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white"><strong>Đánh giá của bạn</strong></div>
                <div class="card-body">
                    <span class="text-warning">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= Model.Review.Rating ? "bi-star-fill" : "bi-star")"></i>
                        }
                    </span>
                    <p class="mb-2">@Model.Review.Comment</p>

                    <form method="post" asp-action="UpdateReview" asp-route-id="@Model.BookingId" class="border-top pt-2">
                        @Html.AntiForgeryToken()
                        <div class="mb-2 rating-stars">
                            @for (var i = 5; i >= 1; i--)
                            {
                                <input type="radio" id="ustar-@i" name="rating" value="@i" @(i == Model.Review.Rating ? "checked" : "") />
                                <label for="ustar-@i"><i class="bi bi-star-fill"></i></label>
                            }
                        </div>
                        <div class="mb-2">
                            <textarea name="comment" class="form-control" rows="2">@Model.Review.Comment</textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary">Cập nhật</button>
                        </div>
                    </form>
                    <form method="post" asp-action="DeleteReview" asp-route-id="@Model.BookingId" class="mt-2"
                          onsubmit="return confirm('Xóa đánh giá này?')">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger">Xóa đánh giá</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
