@{
    ViewData["Title"] = "Nhập mã xác thực";
    var email = (string?)ViewBag.Email;
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-3"><i class="bi bi-shield-check"></i> Nhập mã xác thực</h4>
                <p class="text-muted small text-center">
                    Mã gồm 6 chữ số đã được gửi tới <strong>@email</strong>. Mã có hiệu lực trong 10 phút.
                </p>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@email" />
                    <div class="mb-3">
                        <label class="form-label">Mã xác thực (OTP)</label>
                        <input name="otp" class="form-control form-control-lg text-center"
                               style="letter-spacing:8px;" maxlength="6" pattern="[0-9]{6}"
                               inputmode="numeric" placeholder="000000" required autofocus />
                    </div>
                    <button class="btn btn-success w-100">Xác nhận</button>
                </form>
                <hr />
                <form method="post" asp-action="ForgotPassword" class="text-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@email" />
                    <button class="btn btn-link btn-sm p-0">Không nhận được mã? Gửi lại</button>
                </form>
                <p class="text-center small mt-2 mb-0">
                    <a asp-action="Login" class="text-muted">&larr; Quay lại đăng nhập</a>
                </p>
            </div>
        </div>
    </div>
</div>
