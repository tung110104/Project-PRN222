@{
    ViewData["Title"] = "Đăng nhập quản trị";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-dark">
            <div class="card-header bg-dark text-white text-center">
                <i class="bi bi-shield-lock"></i> Khu vực quản trị viên
            </div>
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-4">Đăng nhập Admin</h4>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="email" type="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <input name="password" type="password" class="form-control" required />
                    </div>
                    <button class="btn btn-dark w-100">Đăng nhập</button>
                </form>
                <hr />
                <p class="text-center mb-0">
                    <a asp-action="Login">&larr; Về trang đăng nhập khách hàng / nhân viên</a>
                </p>
            </div>
        </div>
    </div>
</div>
