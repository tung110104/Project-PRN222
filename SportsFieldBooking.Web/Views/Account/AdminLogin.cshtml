@{
    ViewData["Title"] = "Đăng nhập quản trị";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow border-0">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0"><i class="bi bi-shield-lock-fill"></i> Quản trị hệ thống</h4>
                <small class="text-white-50">Trang đăng nhập dành riêng cho Admin &amp; tài khoản cứu hộ</small>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form method="post" asp-action="AdminLogin">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Email quản trị</label>
                        <input name="email" type="email" class="form-control" required autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <input name="password" type="password" class="form-control" required />
                    </div>
                    <button class="btn btn-dark w-100"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập quản trị</button>
                </form>
                <hr />
                <p class="text-center small text-muted mb-0">
                    Tài khoản Admin bị mất/khóa? Dùng <strong>Super Account</strong> (tài khoản cứu hộ ẩn -
                    không tồn tại trong database lẫn file cấu hình) để đăng nhập và cấp lại quyền.
                </p>
                <p class="text-center small mt-2 mb-0">
                    <a asp-action="Login" class="text-muted">&larr; Về trang đăng nhập khách hàng</a>
                </p>
            </div>
        </div>
    </div>
</div>
