@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-4"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</h4>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="email" type="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <input name="password" type="password" class="form-control" required />
                        <div class="text-end mt-2">
                            <span class="text-muted">Bạn quên mật khẩu? </span>
                            <a asp-action="ForgotPassword" class="text-decoration-underline">
                                Quên mật khẩu
                            </a>
                        </div>
                    </div>
                    <button class="btn btn-success w-100">Đăng nhập</button>
                </form>
                <hr />
                <p class="text-center mb-2">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
                <p class="text-center mb-0">
                    <a asp-action="AdminLogin" class="text-muted small">
                        <i class="bi bi-shield-lock"></i> Đăng nhập dành cho quản trị viên
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
