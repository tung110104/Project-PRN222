@{
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-3"><i class="bi bi-key"></i> Quên mật khẩu</h4>
                <p class="text-muted small text-center">
                    Nhập email tài khoản của bạn. Hệ thống sẽ gửi mã xác thực gồm 6 chữ số qua email.
                </p>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="email" type="email" class="form-control" required autofocus />
                    </div>
                    <button class="btn btn-success w-100"><i class="bi bi-envelope"></i> Gửi mã xác thực</button>
                </form>
                <hr />
                <p class="text-center small mb-0">
                    <a asp-action="Login">&larr; Quay lại đăng nhập</a>
                </p>
                <div class="alert alert-info small mt-3 mb-0">
                    <i class="bi bi-info-circle"></i> Chức năng này dành cho tài khoản khách hàng và chủ sân.
                    Tài khoản quản trị bị mất được khôi phục bằng tài khoản cứu hộ (Super Account).
                </div>
            </div>
        </div>
    </div>
</div>
