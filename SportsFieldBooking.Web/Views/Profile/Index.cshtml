@model SportsFieldBooking.Web.Models.ProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="row g-4">
    <!-- Thông tin cá nhân -->
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle text-success"
                       style="font-size: 70px;"></i>

                    <h4 class="mt-2">Hồ sơ cá nhân</h4>

                    <p class="text-muted mb-0">
                        Quản lý thông tin tài khoản
                    </p>
                </div>

                <form asp-controller="Profile"
                      asp-action="Index"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName"
                               class="form-label">
                            Họ và tên
                        </label>

                        <input asp-for="FullName"
                               class="form-control" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label">
                            Email
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               readonly />

                        <div class="form-text">
                            Email không thể thay đổi.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone"
                               class="form-label">
                            Số điện thoại
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="Nhập số điện thoại" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">
                            Ngày tạo tài khoản
                        </label>

                        <input class="form-control"
                               value="@Model.CreatedAt.ToString("dd/MM/yyyy")"
                               readonly />
                    </div>

                    <button type="submit"
                            class="btn btn-success w-100">
                        <i class="bi bi-save"></i>
                        Cập nhật hồ sơ
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Lịch sử đặt sân -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0">
                    <i class="bi bi-clock-history text-success"></i>
                    Lịch sử đặt sân
                </h4>
            </div>

            @if (Model.Bookings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã</th>
                                <th>Sân</th>
                                <th>Ngày đặt</th>
                                <th>Ngày chơi</th>
                                <th>Tổng tiền</th>
                                <th>Thanh toán</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var booking in Model.Bookings)
                            {
                                var paid =
                                booking.Payments.Any(
                                p => p.Status == "Paid");

                                var refunded =
                                booking.Payments.Any(
                                p => p.Status == "Refunded");

                                <tr>
                                    <td>
                                        #@booking.BookingId
                                    </td>

                                    <td>
                                        @booking.Field.FieldName
                                    </td>

                                    <td>
                                        @booking.CreatedAt.ToString(
                                        "dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <span>
                                            @booking.BookingDate.ToString(
                                            "dd/MM/yyyy")
                                        </span>
                                        <div class="small text-muted">
                                            <span class="badge bg-light text-dark border me-1">
                                                @booking.TimeSlot.StartTime.ToString("HH:mm")
                                                -
                                                @booking.TimeSlot.EndTime.ToString("HH:mm")
                                            </span>
                                        </div>
                                    </td>

                                    <td class="text-success fw-bold">
                                        @booking.TotalAmount.ToString("N0")đ
                                    </td>

                                    <td>
                                        @if (paid)
                                        {
                                            <span class="badge bg-success">
                                                Đã thanh toán
                                            </span>
                                        }
                                        else if (refunded)
                                        {
                                            <span class="badge bg-info">
                                                Đã hoàn tiền
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                            bg-warning text-dark">
                                                Chưa thanh toán
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @switch (booking.Status)
                                        {
                                            case "Pending":
                                                <span class="badge
                                                                    bg-warning text-dark">
                                                    Chờ xác nhận
                                                </span>
                                                break;

                                            case "Confirmed":
                                                <span class="badge bg-primary">
                                                    Đã xác nhận
                                                </span>
                                                break;

                                            case "Completed":
                                                <span class="badge bg-success">
                                                    Hoàn thành
                                                </span>
                                                break;

                                            case "Cancelled":
                                                <span class="badge bg-danger">
                                                    Đã hủy
                                                </span>
                                                break;

                                            default:
                                                <span class="badge
                                                                    bg-secondary">
                                                    @booking.Status
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <a asp-controller="Booking"
                                           asp-action="Detail"
                                           asp-route-id="@booking.BookingId"
                                           class="btn btn-sm
                                                          btn-outline-success">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-center py-5">
                    <i class="bi bi-calendar-x text-muted"
                       style="font-size: 50px;"></i>

                    <p class="text-muted mt-3">
                        Bạn chưa có lịch đặt sân nào.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-success">
                        Đặt sân ngay
                    </a>
                </div>
            }
        </div>
    </div>
</div>