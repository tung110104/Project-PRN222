@{
    ViewData["Title"] = "Ví & Điểm";
    var wallet = (Wallet)ViewBag.Wallet;
    var walletHistory = (List<WalletTransaction>)ViewBag.WalletHistory;
    var pointHistory = (List<PointTransaction>)ViewBag.PointHistory;
}
<h3 class="mb-4"><i class="bi bi-wallet2"></i> Ví tiền ảo &amp; Điểm thưởng</h3>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-bg-success shadow-sm">
            <div class="card-body">
                <h6>Số dư ví @(wallet.IsLocked ? "(BỊ KHÓA)" : "")</h6>
                <h4>@wallet.Balance.ToString("N0")đ</h4>
                <small>Chỉ dùng đặt sân, không rút ra được</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning shadow-sm">
            <div class="card-body">
                <h6>Điểm hiện có</h6>
                <h4>@ViewBag.PointBalance điểm</h4>
                <small>100 điểm = 10.000đ khi thanh toán</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-primary shadow-sm">
            <div class="card-body">
                <h6>Hạng thành viên</h6>
                <h4>@ViewBag.TierName</h4>
                <small>@(ViewBag.TierPercent > 0 ? $"Giảm {ViewBag.TierPercent}% mọi booking" : "Tích điểm để lên hạng")</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-secondary shadow-sm">
            <div class="card-body">
                <h6>Điểm tích lũy trọn đời</h6>
                <h4>@ViewBag.LifetimePoints</h4>
                <small>Bạc ≥500 · Vàng ≥2.000 · Kim cương ≥5.000</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong><i class="bi bi-plus-circle"></i> Nạp tiền (giả lập cổng thanh toán)</strong></div>
            <div class="card-body">
                <form method="post" asp-action="Deposit" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input name="amount" type="number" min="10000" step="10000" class="form-control"
                           placeholder="Số tiền (tối thiểu 10.000đ)" required />
                    <button class="btn btn-success text-nowrap">Nạp ngay</button>
                </form>
                <small class="text-muted">Nạp từ 500.000đ tặng thêm 50.000đ (khuyến mãi nạp).</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong><i class="bi bi-gift"></i> Đổi điểm lấy voucher</strong></div>
            <div class="card-body">
                <form method="post" asp-action="RedeemVoucher"
                      onsubmit="return confirm('Đổi @ViewBag.VoucherCost điểm lấy 1 voucher gửi qua email?')">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-warning">
                        Đổi @ViewBag.VoucherCost điểm → voucher giảm giá (gửi qua email)
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Lịch sử giao dịch ví</strong></div>
            <div class="table-responsive" style="max-height:400px">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light"><tr><th>Thời gian</th><th>Loại</th><th class="text-end">Số tiền</th><th class="text-end">Số dư sau</th></tr></thead>
                    <tbody>
                        @foreach (var t in walletHistory)
                        {
                            <tr title="@t.Note">
                                <td><small>@t.CreatedAt.ToString("dd/MM HH:mm")</small></td>
                                <td><span class="badge bg-light text-dark border">@t.Type</span>
                                    @if (t.BookingId != null)
                                    {
                                        <small class="text-muted">#@t.BookingId</small>
                                    }
                                </td>
                                <td class="text-end @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                    @(t.Amount >= 0 ? "+" : "")@t.Amount.ToString("N0")đ
                                </td>
                                <td class="text-end">@t.BalanceAfter.ToString("N0")đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!walletHistory.Any())
            {
                <div class="card-body text-center text-muted">Chưa có giao dịch nào.</div>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Lịch sử điểm</strong></div>
            <div class="table-responsive" style="max-height:400px">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light"><tr><th>Thời gian</th><th>Loại</th><th class="text-end">Điểm</th><th class="text-end">Còn lại</th></tr></thead>
                    <tbody>
                        @foreach (var t in pointHistory)
                        {
                            <tr title="@t.Note">
                                <td><small>@t.CreatedAt.ToString("dd/MM HH:mm")</small></td>
                                <td><span class="badge bg-light text-dark border">@t.Type</span></td>
                                <td class="text-end @(t.Points >= 0 ? "text-success" : "text-danger")">
                                    @(t.Points >= 0 ? "+" : "")@t.Points
                                </td>
                                <td class="text-end">@t.BalanceAfter</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!pointHistory.Any())
            {
                <div class="card-body text-center text-muted">Chưa có biến động điểm.</div>
            }
        </div>
    </div>
</div>
