@model Field
@{
    ViewData["Title"] = "Sửa sân";
    var fieldTypes = (List<FieldType>)ViewBag.FieldTypes;
}
<h3 class="mb-4"><i class="bi bi-pencil-square"></i> Sửa sân: @Model.FieldName</h3>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="FieldId" value="@Model.FieldId" />
            <div class="col-md-6">
                <label class="form-label">Tên sân *</label>
                <input name="FieldName" value="@Model.FieldName" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Loại sân *</label>
                <select name="FieldTypeId" class="form-select">
                    @foreach (var t in fieldTypes)
                    {
                        <option value="@t.FieldTypeId" selected="@(Model.FieldTypeId == t.FieldTypeId)">@t.TypeName</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Tỉnh / Thành phố *</label>
                <select id="province-select" class="form-select" required>
                    <option value="@Model.ProvinceCode" selected>@Model.ProvinceName</option>
                </select>
                <input type="hidden" name="ProvinceCode" id="ProvinceCode" value="@Model.ProvinceCode" />
                <input type="hidden" name="ProvinceName" id="ProvinceName" value="@Model.ProvinceName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Phường / Xã *</label>
                <select id="ward-select" class="form-select" required>
                    <option value="@Model.WardCode" selected>@Model.WardName</option>
                </select>
                <input type="hidden" name="WardCode" id="WardCode" value="@Model.WardCode" />
                <input type="hidden" name="WardName" id="WardName" value="@Model.WardName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Đường, số nhà *</label>
                <input name="Street" value="@Model.Street" class="form-control" required />
            </div>

            <div class="col-md-3">
                <label class="form-label">Giá mặc định/giờ (đ) *</label>
                <input name="PricePerHour" value="@Model.PricePerHour" type="number" min="1000" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Trạng thái</label>
                <select name="Status" class="form-select">
                    <option value="Active" selected="@(Model.Status == "Active")">Hoạt động</option>
                    <option value="Maintenance" selected="@(Model.Status == "Maintenance")">Bảo trì</option>
                    <option value="Closed" selected="@(Model.Status == "Closed")">Đóng</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Nhận thanh toán ví</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="AcceptWalletPayment" value="true"
                           checked="@Model.AcceptWalletPayment" />
                    <label class="form-check-label">Bật tiền ảo</label>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Cashback trả ví (%)</label>
                <input name="CashbackPercent" value="@Model.CashbackPercent" type="number" min="0" max="100" class="form-control" />
            </div>

            <div class="col-12">
                <label class="form-label">Mô tả</label>
                <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
            </div>

            @if (Model.FieldImages.Any())
            {
                <div class="col-12">
                    <label class="form-label">Ảnh hiện có</label>
                    <div class="d-flex gap-1 flex-wrap">
                        @foreach (var img in Model.FieldImages)
                        {
                            <img src="@img.ImageUrl" style="width:80px;height:60px;object-fit:cover"
                                 class="rounded border @(img.IsPrimary ? "border-success border-2" : "")" />
                        }
                    </div>
                </div>
            }
            <div class="col-12">
                <label class="form-label">Thêm ảnh mới</label>
                <input type="file" name="images" class="form-control" multiple accept="image/*" />
            </div>

            <div class="col-12">
                <button class="btn btn-success">Cập nhật</button>
                <a asp-action="Rules" asp-route-id="@Model.FieldId" class="btn btn-outline-success">Bảng giá</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_AddressApiScripts" />
}
