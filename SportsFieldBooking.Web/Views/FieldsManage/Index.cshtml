@model List<Field>
@{
    ViewData["Title"] = "Quản lý sân";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-grid-3x3-gap"></i> Quản lý sân</h3>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Thêm sân mới</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Tên sân</th>
                    <th>Loại</th>
                    <th>Khu vực</th>
                    <th>Giá thường</th>
                    <th>Giá cao điểm</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.FieldId</td>
                        <td>@f.FieldName</td>
                        <td>@f.FieldType.TypeName</td>
                        <td>@f.District, @f.City</td>
                        <td>@f.PricePerHour.ToString("N0")đ</td>
                        <td>@f.PeakPricePerHour.ToString("N0")đ</td>
                        <td>@f.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            @switch (f.Status)
                            {
                                case "Active": <span class="badge bg-success">Hoạt động</span>; break;
                                case "Maintenance": <span class="badge bg-warning text-dark">Bảo trì</span>; break;
                                case "Closed": <span class="badge bg-danger">Đóng</span>; break;
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@f.FieldId" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form method="post" asp-action="Delete" asp-route-id="@f.FieldId" class="d-inline"
                                  onsubmit="return confirm('Xóa/đóng sân này?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
