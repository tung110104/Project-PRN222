@model Field
@{
    ViewData["Title"] = "Thêm sân mới";
    var fieldTypes = (List<FieldType>)ViewBag.FieldTypes;
}
<h3 class="mb-4"><i class="bi bi-plus-circle"></i> Thêm sân mới</h3>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label class="form-label">Tên sân *</label>
                <input name="FieldName" value="@Model?.FieldName" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Loại sân *</label>
                <select name="FieldTypeId" class="form-select">
                    @foreach (var t in fieldTypes)
                    {
                        <option value="@t.FieldTypeId" selected="@(Model?.FieldTypeId == t.FieldTypeId)">@t.TypeName</option>
                    }
                </select>
            </div>

            <!-- Địa chỉ theo API hành chính VN (mục 7) — không cho nhập tay tỉnh/xã -->
            <div class="col-md-4">
                <label class="form-label">Tỉnh / Thành phố *</label>
                <select id="province-select" class="form-select" required>
                    <option value="">-- Đang tải... --</option>
                </select>
                <input type="hidden" name="ProvinceCode" id="ProvinceCode" value="@Model?.ProvinceCode" />
                <input type="hidden" name="ProvinceName" id="ProvinceName" value="@Model?.ProvinceName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Phường / Xã *</label>
                <select id="ward-select" class="form-select" required>
                    <option value="">-- Chọn tỉnh trước --</option>
                </select>
                <input type="hidden" name="WardCode" id="WardCode" value="@Model?.WardCode" />
                <input type="hidden" name="WardName" id="WardName" value="@Model?.WardName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Đường, số nhà *</label>
                <input name="Street" value="@Model?.Street" class="form-control" required placeholder="VD: 123 Lê Lợi" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Giá mặc định/giờ (đ) *</label>
                <input name="PricePerHour" value="@Model?.PricePerHour" type="number" min="1000" class="form-control" required />
                <small class="text-muted">Giá cao điểm/cuối tuần/mùa cấu hình ở "Bảng giá" sau khi tạo.</small>
            </div>
            <div class="col-md-4">
                <label class="form-label">Nhận thanh toán ví</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="AcceptWalletPayment" value="true"
                           checked="@(Model?.AcceptWalletPayment == true)" />
                    <label class="form-check-label">Bật tiền ảo cho sân này</label>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Cashback khi trả ví (%)</label>
                <input name="CashbackPercent" value="@(Model?.CashbackPercent ?? 0)" type="number" min="0" max="100" class="form-control" />
            </div>

            <div class="col-12">
                <label class="form-label">Mô tả</label>
                <textarea name="Description" class="form-control" rows="3">@Model?.Description</textarea>
            </div>
            <div class="col-12">
                <label class="form-label">Ảnh sân (tối đa 10, ảnh đầu là đại diện)</label>
                <input type="file" name="images" class="form-control" multiple accept="image/*" />
            </div>
            <div class="col-12">
                <button class="btn btn-success">Lưu sân</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_AddressApiScripts" />
}
