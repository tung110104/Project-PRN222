@model Field
@{
    ViewData["Title"] = "Thêm sân mới";
    var fieldTypes = (List<FieldType>)ViewBag.FieldTypes;
}
<h3 class="mb-4"><i class="bi bi-plus-circle"></i> Thêm sân mới</h3>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label class="form-label">Tên sân *</label>
                <input name="FieldName" value="@Model?.FieldName" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Loại sân *</label>
                <select name="FieldTypeId" class="form-select">
                    @foreach (var t in fieldTypes)
                    {
                        <option value="@t.FieldTypeId" selected="@(Model?.FieldTypeId == t.FieldTypeId)">@t.TypeName</option>
                    }
                </select>
            </div>

            @* Dia chi chi tiet: Tinh/Thanh -> Phuong/Xa do tu API hanh chinh VN, khong nhap tay *@
            <div class="col-md-4">
                <label class="form-label">Tỉnh/Thành phố *</label>
                <select id="provinceSelect" class="form-select" required>
                    @if (!string.IsNullOrWhiteSpace(Model?.Province))
                    {
                        <option value="@Model.Province" data-name="@Model.Province" selected>@Model.Province</option>
                    }
                    else
                    {
                        <option value="">-- Đang tải... --</option>
                    }
                </select>
                <input type="hidden" name="Province" id="provinceInput" value="@Model?.Province" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Phường/Xã *</label>
                <select id="wardSelect" class="form-select" required @(string.IsNullOrWhiteSpace(Model?.Province) ? "disabled" : "")>
                    @if (!string.IsNullOrWhiteSpace(Model?.Ward))
                    {
                        <option value="@Model.Ward" data-name="@Model.Ward" selected>@Model.Ward</option>
                    }
                    else
                    {
                        <option value="">-- Chọn Tỉnh/Thành trước --</option>
                    }
                </select>
                <input type="hidden" name="Ward" id="wardInput" value="@Model?.Ward" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Số nhà, tên đường *</label>
                <input name="Address" value="@Model?.Address" class="form-control" placeholder="VD: 123 Lê Lợi" required />
            </div>

            <div class="col-md-4">
                <label class="form-label">Giá cơ bản (đ/giờ) *</label>
                <input name="PricePerHour" value="@Model?.PricePerHour" type="number" min="1000" class="form-control" required />
                <small class="text-muted">Bảng giá chi tiết theo giờ/ngày/mùa cấu hình sau khi tạo sân.</small>
            </div>
            <div class="col-md-4">
                <label class="form-label">Ví tiền ảo</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="AcceptWalletPayment" value="true"
                           checked="@(Model?.AcceptWalletPayment == true)" />
                    <label class="form-check-label">Chấp nhận thanh toán bằng ví</label>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Cashback khi trả bằng ví (%)</label>
                <input name="CashbackPercent" value="@(Model?.CashbackPercent ?? 0)" type="number" min="0" max="50" class="form-control" />
            </div>

            <div class="col-12">
                <label class="form-label">Mô tả</label>
                <textarea name="Description" class="form-control" rows="3">@Model?.Description</textarea>
            </div>

            <div class="col-12">
                <label class="form-label"><i class="bi bi-images"></i> Ảnh sân</label>
                <input type="file" name="imageFiles" id="imageInput" class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" multiple />
                <small class="text-muted">Chọn được nhiều ảnh (JPG/PNG/WEBP, tối đa 5MB/ảnh). Ảnh đầu tiên sẽ là ảnh đại diện của sân.</small>
                <div id="imagePreview" class="d-flex flex-wrap gap-2 mt-2"></div>
            </div>
            <div class="col-12">
                <button class="btn btn-success">Lưu sân</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/address-select.js" asp-append-version="true"></script>
    <script>
        initAddressSelect(
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Province ?? "")),
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Ward ?? ""))
        );
    </script>
    <script>
        // Xem truoc anh vua chon
        document.getElementById('imageInput').addEventListener('change', function () {
            const box = document.getElementById('imagePreview');
            box.innerHTML = '';
            [...this.files].forEach((f, idx) => {
                if (!f.type.startsWith('image/')) return;
                const wrap = document.createElement('div');
                wrap.className = 'position-relative';
                const img = document.createElement('img');
                img.src = URL.createObjectURL(f);
                img.className = 'rounded border';
                img.style.cssText = 'width:120px;height:85px;object-fit:cover';
                wrap.appendChild(img);
                if (idx === 0) {
                    const badge = document.createElement('span');
                    badge.className = 'badge bg-success position-absolute top-0 start-0 m-1';
                    badge.textContent = 'Đại diện';
                    wrap.appendChild(badge);
                }
                box.appendChild(wrap);
            });
        });
    </script>
}
