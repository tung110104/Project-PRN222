        <mxCell id="note1" parent="1" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;whiteSpace=wrap;rounded=1;fontSize=11;align=left;spacing=8;" value="Notation: solid line = association; dashed arrow &#171;include&#187; = the base use case always performs the included one; dashed arrow &#171;extend&#187; = optional/conditional behaviour added to the base use case (condition in brackets); hollow triangle = actor generalization (Admin inherits Owner, Owner inherits Customer, Customer inherits Guest). The Super Account is a hidden rescue account with no business features." vertex="1">
